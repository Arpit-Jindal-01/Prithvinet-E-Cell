# PostgreSQL connection string (Render injects this automatically)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/prithvinet

# JWT — generate a strong random string (Render auto-generates via render.yaml)
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=60

# Groq AI — get free key at https://console.groq.com
GROQ_API_KEY=

# WAQI air quality token — "demo" works for basic use, get your own at https://aqicn.org/data-platform/token/
WAQI_TOKEN=demo

# Set to your Vercel frontend URL after deploying (e.g. https://prithvinet.vercel.app)
FRONTEND_URL=
